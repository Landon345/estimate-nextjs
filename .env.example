# DEV uses DATABASE_URL; PRODUCTION (the deployed site) uses CLOUD_DATABASE_URL.
ENVIRONMENT="DEV"

# Local Postgres. Create the database first: createdb -U postgres estimate
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/estimate?schema=public"

# Optional. Either key turns on the "Suggest an estimate" button on the task
# forms; Gemini is used if both are set. Gemini keys: https://aistudio.google.com/apikey
# GEMINI_API_KEY="..."
# ANTHROPIC_API_KEY="sk-ant-..."

# Hosted Prisma Postgres (pooled string): the app's database when ENVIRONMENT is
# PRODUCTION, and the target of the db:cloud:* scripts.
# CLOUD_DATABASE_URL="postgres://USER:PASSWORD@pooled.db.prisma.io:5432/postgres?sslmode=verify-full"
